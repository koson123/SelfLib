# Exact browser-facing root URL. HTTPS enables Secure cookies automatically.
APP_URL=http://localhost:3000
# Loopback is safest for a local install or a reverse proxy on the host.
# Set to 0.0.0.0 intentionally to allow LAN access; use HTTPS for real credentials.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000
# Upstream connections are added in the owner UI. Do not put their secrets here.
